# Optional overrides for the transcription service. Nothing here needs filling
# in: every setting has a built-in default, shown on its line below, and the
# usual way to change one is Settings in the page (the gear button at the top
# right), which applies at once and saves to ./data/settings.json.
#
# This file is for deployments that prefer configuration in a file. Copy it to
# .env, uncomment a line and set its value, and Compose passes it into the
# container on the next start. Values apply in this order, later winning: the
# built-in defaults, then .env, then what was saved from the page.

# ---- Transcription ----------------------------------------------------------

# Default language, preselected for new transcriptions. auto detects the
# language per file; naming it (en, da, sv, ...) is more reliable on short or
# noisy audio.
#WHISPER_LANGUAGE=auto

# ---- Local model ------------------------------------------------------------

# Ollama address. host.docker.internal reaches an Ollama on this machine from
# inside Docker; use http://localhost:11434 when running the app outside Docker.
#OLLAMA_BASE_URL=http://host.docker.internal:11434

# The Ollama tag to analyse with. Pull it first: ollama pull gemma4:e4b
#GEMMA_MODEL_NAME=gemma4:e4b

# How long Ollama keeps the model in memory after an analysis. 0 unloads it at
# once so the memory is free for the next transcription; a duration such as 30m
# keeps it ready so only the first analysis pays the load.
#OLLAMA_KEEP_ALIVE=0

# How long to wait for an analysis, in seconds. A cold model load costs about
# 35 seconds and a 45-minute transcript about 90 more.
#OLLAMA_TIMEOUT_SECONDS=600

# ---- Cloud Gemini -----------------------------------------------------------

# API key from https://aistudio.google.com/app/apikey. Kept on this machine
# only, and used only when you pick Cloud Gemini. Empty by default.
#GEMINI_API_KEY=

# The Gemini model id. gemini-flash-latest follows Google's newest Flash release
# and changes with it; a specific id such as gemini-3.5-flash pins one.
#GEMINI_MODEL_NAME=gemini-flash-latest

# ---- Advanced: the context window -------------------------------------------
# Ollama drops the front of a prompt that does not fit its window and does not
# say so, so the window is sized from each transcript rather than left at the
# server default. These settings bound that choice.

# Smallest window to ask for, in tokens. Anything smaller truncates a
# transcript of real length.
#OLLAMA_NUM_CTX_MIN=8192

# Largest window to ask for, as a guard on memory: a big window means a big
# key-value cache. Empty allows whatever the model reports it supports.
#OLLAMA_NUM_CTX_MAX=

# Fixed window that turns automatic sizing off and always asks for this many
# tokens. Empty keeps sizing automatic.
#OLLAMA_NUM_CTX=

# Tokens reserved out of the window for the answer; prompt and answer share it.
#OLLAMA_NUM_PREDICT=2000

# Characters per token, used to estimate a transcript with no tokeniser present.
# Lower is more cautious; 3.0 suits Danish and mixed-language transcripts.
#OLLAMA_CHARS_PER_TOKEN=3.0
