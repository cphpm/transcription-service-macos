# Gemini API Configuration
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Ollama Configuration (using your local Ollama installation)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Gemma model name as tagged in Ollama (pull it first: ollama pull gemma4:e4b)
GEMMA_MODEL_NAME=gemma4:e4b

# How long to wait for a local analysis. A cold model load costs about 35s and a
# 45-minute transcript takes around 90s more, so keep plenty of headroom.
OLLAMA_TIMEOUT_SECONDS=600

# Keep the model in memory between analyses so only the first one pays the load.
OLLAMA_KEEP_ALIVE=30m

# Context window. Ollama drops the front of a prompt that does not fit and does
# not report it, so the window is sized from each transcript instead of left at
# the server default. These settings bound that choice.

# Smallest window to ask for. Applied unless the model itself supports less.
OLLAMA_NUM_CTX_MIN=32768

# Largest window to ask for, as a guard on host memory: a big window means a big
# key-value cache. Leave empty to allow whatever the model reports it supports.
OLLAMA_NUM_CTX_MAX=

# Fixed window that turns automatic sizing off entirely. Leave empty for auto.
OLLAMA_NUM_CTX=

# Tokens reserved out of the window for the answer. Prompt and answer share it.
OLLAMA_NUM_PREDICT=2000

# Characters per token, used to estimate a transcript with no tokeniser present.
# Lower is more cautious. 3.0 suits Danish and mixed-language transcripts, which
# tokenise less efficiently than English.
OLLAMA_CHARS_PER_TOKEN=3.0

# Default transcription language shown in the UI ('auto' detects per file)
WHISPER_LANGUAGE=auto
